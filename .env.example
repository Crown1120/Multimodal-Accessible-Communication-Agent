# ============ Bridge 环境变量示例 ============
# 复制为 .env 并按需修改

# 应用
APP_NAME=Bridge
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api

# 服务
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# 数据库（SQLite + aiosqlite）
SQLITE_URL=sqlite+aiosqlite:///./bridge.db
SQLITE_ECHO=false
# PostgreSQL（可选，设置后优先使用）
# POSTGRES_URL=postgresql+asyncpg://bridge:bridge@localhost:5432/bridge
# 启动时自动执行 Alembic 迁移（upgrade head）
AUTO_MIGRATE=true

# 向量库（Chroma；留空则使用内存中文 n-gram 检索）
CHROMA_PATH=./chroma_data
CHROMA_COLLECTION=bridge_knowledge
CHROMA_EMBEDDING=

# LLM / ASR / TTS（阶段1起逐步接入）
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.3
LLM_MAX_RETRIES=2
# 规则分类落到兜底时再用 LLM 判一次意图
LLM_INTENT_ENABLED=true
LLM_INTENT_TIMEOUT_SECONDS=6

# ASR 语音转文字（阶段3接入）
ASR_PROVIDER=openai
ASR_API_KEY=
ASR_BASE_URL=https://api.openai.com/v1
ASR_MODEL=whisper-1
ASR_LANGUAGE=zh
# 火山/豆包语音（新版控制台 APP Key，ASR 与 TTS 共用）
VOLC_ASR_X_API_KEY=
VOLC_ASR_RESOURCE_ID=volc.bigasr.auc_turbo

# TTS 文字转语音（阶段3接入，支持慢速）
TTS_PROVIDER=openai
TTS_API_KEY=
TTS_BASE_URL=https://api.openai.com/v1
TTS_MODEL=tts-1
TTS_VOICE=alloy
TTS_SPEED=1.0
TTS_SEEDTTS_RESOURCE_ID=

# 数字人（魔珐星云）
# 注意：星云 SDK 要求 appSecret 出现在浏览器中（官方设计如此），属公开凭据。
# 放在后端可避免被内联进前端静态产物，并支持不重新构建前端即轮换密钥。
# 生产环境请使用「域名白名单 + 配额限制」的专用密钥，不要复用其它系统密钥。
XINGYUN_APP_ID=
XINGYUN_APP_SECRET=
XINGYUN_GATEWAY=https://nebula-agent.xingyun3d.com/user/v1/ttsa/session

# 会话
SESSION_TIMEOUT_MINUTES=60
MAX_MESSAGE_LENGTH=2000
AGENT_TIMEOUT_SECONDS=30
MAX_UPLOAD_MB=10

# 安全与限流
# 运维接口（POST /api/knowledge/reindex）令牌；为空时仅允许本机访问
ADMIN_TOKEN=
# 单客户端每分钟允许的消息/音频请求数，0 表示不限流
RATE_LIMIT_PER_MINUTE=60

# 日志
LOG_LEVEL=INFO
LOG_FILE=./logs/bridge.log

# 前端（Vite）
VITE_API_BASE=http://localhost:8000/api
VITE_WS_BASE=ws://localhost:8000
